[Unit]
Description=Spoken AI Studio public eSpeak NG and Festival test provider
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/fast/work/llm-fight-club-tts-bakeoff-20260830
Environment=CLASSIC_TTS_HOST=127.0.0.1
Environment=CLASSIC_TTS_PORT=18875
Environment=CLASSIC_TTS_ALLOWED_ORIGIN=https://lozknowles.com
Environment=CLASSIC_TTS_ROOT=/fast/work/spoken-ai-tts-tools-20260830/root
Environment=TMPDIR=/tmp
ExecStart=/usr/bin/node speech/classic-tts-service.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
