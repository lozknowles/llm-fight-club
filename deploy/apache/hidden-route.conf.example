# Place inside the LozKnowles.com TLS VirtualHost. Keep the real route private.
RedirectMatch 302 "^/UNLISTED_PATH$" "/UNLISTED_PATH/audio.html"
ProxyPass        "/UNLISTED_PATH/" "http://100.125.120.114:18770/" connectiontimeout=5 timeout=600 retry=0
ProxyPassReverse "/UNLISTED_PATH/" "http://100.125.120.114:18770/"

<Location "/UNLISTED_PATH/">
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Prefix "/UNLISTED_PATH"
    Header always set Cache-Control "no-store, private"
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'"
</Location>
