# Public template only. All credentials are intentionally blank.
# Copy to .env.local; that file is ignored by Git. Use Node 24 LTS.
# Keep shared settings here; load credentials only in the service needing them.
HOST=127.0.0.1
PORT=18770
FIGHT_CLUB_MODEL_ROUTES={"qwen2.5:3b":"http://127.0.0.1:11434/v1"}
FIGHT_CLUB_SPEECH_URL=http://127.0.0.1:18772
SPEECH_ROUTER_HOST=127.0.0.1
SPEECH_ROUTER_PORT=18772
FLITE_HOST=127.0.0.1
FLITE_PORT=18774
FLITE_TTS_URL=http://127.0.0.1:18774

# Optional paid speech credentials; leave blank for the local Flite setup.
OPENAI_API_KEY=""
# Optional ElevenLabs credential (empty).
ELEVENLABS_API_KEY=""
# ElevenLabs also needs a JSON voice mapping; see docs/CONFIGURATION.md.
ELEVENLABS_VOICE_MAP={}
ELEVENLABS_TTS_MODEL=eleven_v3

# Optional Voice Lab stays disabled. Follow VOICE-LAB.md before enabling it.
VOICE_LAB_ENABLED=0
VOICE_LAB_FIGHT_CLUB_ENABLED=0
VOICE_LAB_ACCESS_KEY=""
# Optional worker credential (empty).
VOICE_LAB_WORKER_TOKEN=""
# Optional upstream credential (empty).
OMNIVOICE_UPSTREAM_TOKEN=""

# Prepared-battle preview is opt-in. Never expose it without private access controls.
FIGHT_CLUB_PREPARED_ENABLED=0
AGENT_CONTROL_SPEECH_URL=http://127.0.0.1:19396
AGENT_CONTROL_SPEECH_TOKEN=""
# Server-side model credentials are configured privately, never in this template.
FIGHT_CLUB_MODEL_API_KEYS={}
